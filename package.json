{
  "name": "teamos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@teamos/api",
    "dev:web": "npm run dev --workspace=@teamos/web",
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,web\" -c \"cyan.bold,green.bold\" \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "seed": "npm run seed --workspace=@teamos/api",
    "seed:large": "npm run seed:large --workspace=@teamos/api",
    "prepare": "husky || exit 0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "autocannon": "^9.0.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
