# ==============================================================================
# TeamOS — Environment Configuration Example (.env.example)
# Copy this file to .env and fill in your values.
# ==============================================================================

# Core App Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=teamos_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5433/teamos_db?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Authentication Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET="your_64_byte_hex_access_secret"
JWT_REFRESH_SECRET="your_64_byte_hex_refresh_secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Authorized Redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Email Provider
# Options: console | ethereal | resend | smtp
EMAIL_PROVIDER=console
RESEND_API_KEY=""
EMAIL_FROM="TeamOS <no-reply@teamos.local>"

# File Storage
# Options: local | cloudinary | s3
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Speech-to-Text
# Options: openai (Whisper API) | browser (Web Speech API fallback)
SPEECH_PROVIDER=browser
WHISPER_API_KEY=""

# GitHub Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# AI Engine & Vector Search
# Options: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"
